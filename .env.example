# ==============================================================================
# MindScan Production & Local Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
# 2. Fill in the values below with your specific environment configurations.
# 3. NEVER commit your actual '.env' file containing real secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL & APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# PROJECT_NAME: Display name for the clinical screening application
PROJECT_NAME="MindScan: Multimodal Depression Screening Support"

# ENVIRONMENT: Current runtime mode ("production" or "development")
# In production, OpenAPI interactive docs are disabled by default for security.
ENVIRONMENT=production

# DEBUG: Turn debug features on/off (Set to False in production)
DEBUG=False

# API_V1_STR: Base URL routing prefix for v1 API endpoints
API_V1_STR=/api/v1

# LOG_LEVEL: Python logging verbosity ("INFO", "WARNING", "ERROR", "DEBUG")
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL in Production, SQLite in Dev)
# ------------------------------------------------------------------------------
# DATABASE_URL:
#   - In Production: Connection string to managed PostgreSQL instance.
#     Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
#     Example (Supabase): postgresql://postgres:mypassword@db.xyz.supabase.co:5432/postgres
#     Example (Render):   postgresql://mindscan_user:pass@dpg-xxxx.render.com/mindscan_db
#     Example (Neon):     postgresql://user:pass@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb
#   - In Local Development: Keep empty or use SQLite fallback:
#     sqlite:///mindscan.db
DATABASE_URL=postgresql://mindscan:replace-with-db-password@localhost:5432/mindscan


# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# SECRET_KEY: Cryptographically secure random secret key used for signing JWT tokens.
# Must be at least 32 characters long. Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-secret-key!

# ALGORITHM: Cryptographic signing algorithm for JWT tokens (default: HS256)
ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES: Access token lifetime in minutes (e.g. 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# REFRESH_TOKEN_EXPIRE_DAYS: Refresh token lifetime in days (e.g. 7 days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# SECURE_COOKIES: Enforce HTTPS-only flags on session cookies (Set True in production)
SECURE_COOKIES=True


# ------------------------------------------------------------------------------
# 4. SECURE REGISTRATION ACCESS CODES
# ------------------------------------------------------------------------------
# ADMIN_REGISTRATION_CODE:
#   Required when registering a new system account with role "Admin".
#   Compared server-side using constant-time comparison (secrets.compare_digest).
#   If left blank, admin registration is disabled on the server.
#   Generate via: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_REGISTRATION_CODE=replace-with-secure-admin-passcode-2026

# CLINICIAN_REGISTRATION_CODE:
#   Optional passcode when registering with role "Clinician".
#   If matching, clinician account is active immediately.
#   If omitted, account is created as User and a pending clinician request is queued for Admin approval.
CLINICIAN_REGISTRATION_CODE=replace-with-secure-clinician-passcode-2026


# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID created in Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET: OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GOOGLE_REDIRECT_URI: The exact redirect URI configured in Google Cloud Console
# For Local Dev:   http://localhost:3000/login.html
# For Production:  https://your-frontend-domain.com/login.html
GOOGLE_REDIRECT_URI=https://your-frontend-domain.com/login.html


# ------------------------------------------------------------------------------
# 6. CORS & FRONTEND URL CONFIGURATION
# ------------------------------------------------------------------------------
# FRONTEND_URL: Canonical public URL where your frontend is hosted
FRONTEND_URL=https://your-frontend-domain.com

# CORS_ORIGINS: Comma-separated list of allowed frontend origins that can make API requests
# Include live domain, Vercel/Netlify preview domains, and local ports for testing.
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:3000,http://127.0.0.1:3000


# ------------------------------------------------------------------------------
# 7. MODEL WEIGHTS CONFIGURATION & CLOUD STORAGE
# ------------------------------------------------------------------------------
# MODELS_DIR: Local directory path where downloaded model checkpoints are cached.
# Defaults to "./models" inside backend.
MODELS_DIR=./models

# HF_MODEL_REPO_ID: (Optional) Hugging Face Hub repository containing pre-trained weights.
# When provided, the backend automatically downloads missing weights on initial start.
# Example: your-organization/mindscan-multimodal-weights
HF_MODEL_REPO_ID=

# DOWNLOAD_MODELS_ON_STARTUP: Set to True to trigger model download during startup
DOWNLOAD_MODELS_ON_STARTUP=False


# ------------------------------------------------------------------------------
# 8. PERFORMANCE & WORKER CONCURRENCY
# ------------------------------------------------------------------------------
# WEB_CONCURRENCY: Number of Uvicorn worker processes.
# CAUTION: Machine learning models (PyTorch + Wav2Vec2 + Transformers) consume ~600MB-1GB RAM per worker.
# Keep WEB_CONCURRENCY=1 for free/starter container tiers (512MB - 1GB RAM) to prevent OOM errors.
# Set to 2 only if container has >= 2.5GB RAM.
WEB_CONCURRENCY=1
