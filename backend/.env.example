# ==============================================================================
# MindScan Production & Local Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
# 2. Fill in the values below with your specific environment configurations.
# 3. NEVER commit your actual '.env' file containing real secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL & APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="MindScan: Multimodal Depression Screening Support"
ENVIRONMENT=production
DEBUG=False
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL in Production, SQLite in Dev)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://mindscan:replace-with-db-password@localhost:5432/mindscan

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
SECRET_KEY=replace-with-a-secure-random-32-byte-secret-key!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=True

# ------------------------------------------------------------------------------
# 4. SECURE REGISTRATION ACCESS CODES
# ------------------------------------------------------------------------------
ADMIN_REGISTRATION_CODE=replace-with-secure-admin-passcode-2026
CLINICIAN_REGISTRATION_CODE=replace-with-secure-clinician-passcode-2026

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-frontend-domain.com/login.html

# ------------------------------------------------------------------------------
# 6. CORS & FRONTEND URL CONFIGURATION
# ------------------------------------------------------------------------------
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 7. MODEL WEIGHTS CONFIGURATION & CLOUD STORAGE
# ------------------------------------------------------------------------------
MODELS_DIR=./models
HF_MODEL_REPO_ID=
DOWNLOAD_MODELS_ON_STARTUP=False

# ------------------------------------------------------------------------------
# 8. PERFORMANCE & WORKER CONCURRENCY
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=1
